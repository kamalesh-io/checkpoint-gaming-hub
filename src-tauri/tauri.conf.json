{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CHECKPOINT Gaming Hub",
  "version": "1.1.0",
  "identifier": "com.checkpoint.gaminghub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Checkpoint Gaming Hub",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#111722"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CHECKPOINT",
    "copyright": "Copyright \u00a9 2026 CHECKPOINT. All rights reserved.",
    "externalBin": [
      "binaries/checkpoint-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyQzM5RDA2QzAzRjIxQjgKUldTNElUL0FCcDNEY3FSSWdzVDl5d2FJTEgybDkvQVVHakJxR29veWxCamdvaW1HL2ZNMEh2ZDYK",
      "endpoints": [
        "https://github.com/kamalesh-io/checkpoint-gaming-hub/releases/latest/download/latest.json"
      ]
    }
  }
}
# CHECKPOINT Gaming Hub - Environment Variables Template
# Copy this file to .env and provide your actual API keys.
# NEVER commit or expose the real .env file.

APP_NAME="CHECKPOINT Gaming Hub"
APP_VERSION="1.0.0"
APP_ENV=development
HOST=127.0.0.1
PORT=8765

# Twitch / IGDB API Credentials
# Obtain from https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=your_igdb_client_id_here
IGDB_CLIENT_SECRET=your_igdb_client_secret_here

# SteamGridDB API Key
# Obtain from https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=your_steamgriddb_api_key_here

# Steam Web API Key (Optional for Steam library sync & achievements)
# Obtain from https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=your_steam_web_api_key_here

# IsThereAnyDeal API Key (Optional for wishlist price tracking)
# Obtain from https://isthereanydeal.com
ITAD_API_KEY=your_itad_api_key_here

# SQLite Database (optional override, defaults to %APPDATA%/Checkpoint/data/checkpoint.db)
DATABASE_URL=sqlite+aiosqlite:///checkpoint.db

# Security Token (optional for dev; if unset, auto-generated in dev or required via header)
CHECKPOINT_AUTH_TOKEN=dev_secret_token_change_in_prod

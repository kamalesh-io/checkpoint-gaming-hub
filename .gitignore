# CHECKPOINT Gaming Hub - .gitignore

# Environment & Secrets (NEVER COMMIT)
.env
*.env
.env.*
!.env.example
credentials.json
**/credentials.json

# Local SQLite Databases & WAL files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
checkpoint.db

# Artwork Cache & Local Media Storage
artwork_cache/
cache/
.cache/
userdata/
storage/
media/

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
dist/
dist-ssr/
*.local
.vite/

# Tauri 2.0 & Rust
target/
src-tauri/target/
**/src-tauri/target/
*.pdb
*.exe
*.msi
src-tauri/binaries/*.exe
!src-tauri/binaries/.gitkeep

# Test artifacts & Logs
test_appdata_standalone*/
*.log

# Operating System & IDE
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
